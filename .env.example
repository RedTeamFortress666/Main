# Master key used to decrypt an HOPENV1 .env (32 bytes as 64 hex chars).
# HOP_ENV_KEY=

# Rotation interval in minutes (1-59). Cron: */N * * * *
HOP_INTERVAL_MINUTES=15
HOP_TTL_MINUTES=30

# JSON array of operator-owned WireGuard profiles and/or SOCKS5 endpoints.
# WireGuard PrivateKey values stay on this host and are never published.
HOP_ENDPOINTS=[{"id":"exit-a","wireguard":{"interface":"wg0","config":"[Interface]\\nAddress = 10.8.0.2/32\\n[Peer]\\nPublicKey = peerpk\\nEndpoint = 203.0.113.10:51820\\n"},"socks5":{"host":"203.0.113.10","port":1080}}]

# ML-DSA-65 keys from: npm run hop -- keygen
HOP_MLDSA_PUBLIC_KEY=
HOP_MLDSA_SECRET_KEY=

# Optional Redis / Valkey (rediss:// for TLS)
# HOP_REDIS_URL=rediss://default:password@valkey.example:6379
# HOP_REDIS_KEY=hop:current

# Optional DNS TXT publish (Cloudflare or generic HTTP API)
# HOP_DNS_NAME=hop.example.com
# HOP_DNS_PROVIDER=cloudflare
# HOP_DNS_TOKEN=
# HOP_DNS_ZONE_ID=
# HOP_DNS_GENERIC_URL=https://dns.example.com/txt

# Optional local apply hook (execFile, no shell). Writes runtime files first.
# HOP_RUNTIME_DIR=.hop-runtime
# HOP_ACTIVATE_COMMAND=/usr/local/bin/hop-activate
# HOP_ACTIVATE_ARGS=["--apply"]
# HOP_PUBLISH_SOCKS_PASSWORD=0
