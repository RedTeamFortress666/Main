# Merge into arch/arm64/configs/lineageos_r36s_defconfig (or run olddefconfig).
# Stock AndR36oid already has USB host (DWC2_HOST), USB HID, BT LE, Wi-Fi.
#
# USB-UART: ESP32-S3 LoRa sticks and FTDI/CP210x/CH340 dongles.
# Gamepads use the existing HID/evdev stack — do NOT expose hidraw as 0666.

CONFIG_USB_ACM=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_HID_MULTITOUCH=y

# Hardening (Rockchip 4.4 — unknown options are skipped by apply.sh).
CONFIG_SYN_COOKIES=y
CONFIG_SECURITY_DMESG_RESTRICT=y
# CONFIG_DEVMEM is not set
# CONFIG_DEVKMEM is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_KEXEC is not set
# CONFIG_MAGIC_SYSRQ is not set
