<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Battery: do not keep the panel awake 24/7 (stock AndR36oid does). -->
    <bool name="def_stay_on_while_plugged_in">false</bool>
    <integer name="def_screen_off_timeout">120000</integer>
    <integer name="def_sleep_timeout">300000</integer>
    <bool name="def_dim_screen">true</bool>

    <!-- Mesh: BLE on at first boot. Always-scan stays off (Route tab). -->
    <bool name="def_bluetooth_on">true</bool>
    <bool name="def_wifi_on">true</bool>
    <bool name="def_wifi_scan_always_available">false</bool>

    <!-- Privacy: lockscreen available; no theater mode. -->
    <bool name="def_lockscreen_disabled">false</bool>
    <bool name="def_backup_enabled">false</bool>
    <bool name="def_package_verifier_enable">false</bool>

    <!-- F-Droid / sideload. No Play Protect. -->
    <bool name="def_install_non_market_apps">true</bool>
    <bool name="def_netstats_enabled">false</bool>
</resources>
