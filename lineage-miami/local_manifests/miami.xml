<?xml version="1.0" encoding="UTF-8"?>
<!--
  LineageOS 23.2 local manifest for Motorola edge 30 neo (miami).

  Copy to an Android tree as:
    .repo/local_manifests/miami.xml

  Then: repo sync
  Or:   breakfast miami  (roomservice will pull device/kernel/HAL;
                          vendor still needs this file or TheMuppets blobs)

  Upstream remotes use LineageOS / TheMuppets. After GitHub forks exist under
  RedTeamFortress666, switch to miami-fork.xml.
-->
<manifest>
  <project name="LineageOS/android_device_motorola_miami"
           path="device/motorola/miami"
           remote="github"
           revision="lineage-23.2" />
  <project name="LineageOS/android_device_motorola_sm6375-common"
           path="device/motorola/sm6375-common"
           remote="github"
           revision="lineage-23.2" />
  <project name="LineageOS/android_kernel_motorola_sm6375"
           path="kernel/motorola/sm6375"
           remote="github"
           revision="lineage-23.2" />
  <project name="LineageOS/android_hardware_motorola"
           path="hardware/motorola"
           remote="github"
           revision="lineage-23.2" />
  <project name="TheMuppets/proprietary_vendor_motorola_miami"
           path="vendor/motorola/miami"
           remote="github"
           revision="lineage-23.2" />
  <project name="TheMuppets/proprietary_vendor_motorola_sm6375-common"
           path="vendor/motorola/sm6375-common"
           remote="github"
           revision="lineage-23.2" />
</manifest>
